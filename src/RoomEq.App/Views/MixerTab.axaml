<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RoomEq.App.Controls"
             x:Class="RoomEq.App.Views.MixerTab">

    <UserControl.Styles>
        <!-- statut de routage coloré -->
        <Style Selector="TextBlock.active">
            <Setter Property="Foreground" Value="#4ADE80"/>
        </Style>
        <!-- tranche sélectionnée -->
        <Style Selector="Border.strip.selected">
            <Setter Property="BorderBrush" Value="#FF9F1C"/>
            <Setter Property="BorderThickness" Value="1.4"/>
        </Style>
        <!-- commutateurs de tranche -->
        <Style Selector="ToggleButton.mute:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#F0533F"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton.solo:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFC53D"/>
            <Setter Property="Foreground" Value="#12141A"/>
        </Style>
        <Style Selector="ToggleButton.ms">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.mini">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Slider.fader">
            <Setter Property="Width" Value="34"/>
        </Style>
        <!-- espacement des éléments de la barre à retour (WrapPanel sans Spacing) -->
        <Style Selector="WrapPanel > TextBlock">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="WrapPanel > Button">
            <Setter Property="Margin" Value="0,0,8,4"/>
        </Style>
        <Style Selector="WrapPanel > CheckBox">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0">

            <!-- ═══ EQ système (APO) — décision D24 : LE chemin du son Windows,
                 sans pilote ni mode test ni tierce partie ; une activation =
                 une invite administrateur. Placé en tête (D25) : la voie
                 principale — la console ne sert plus qu'aux sources internes ═══ -->
            <Border IsVisible="{Binding !IsMacOS}" Background="#1B1F27" CornerRadius="6"
                    BorderBrush="#2A2F3A" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
                <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="EQ système (sans pilote)" FontWeight="Bold" FontSize="12"
                                       VerticalAlignment="Center"
                                       Classes.active="{Binding AnySystemApoEnabled}"/>
                            <controls:HelpButton HelpTitle="EQ système — comment ça marche"
                                                 HelpText="L'égaliseur de RoomEq s'installe DANS le moteur audio de Windows (technologie officielle « Audio Processing Object », la même que les effets Realtek/Dolby) : tout ce qui sort par une sortie activée traverse l'égaliseur — musique, navigateur, jeux, notifications.&#10;&#10;• Aucun pilote, aucun mode test, aucun logiciel tiers ; latence ajoutée NULLE (aucune désynchro son/image).&#10;• Activation = une invite administrateur, le son s'interrompt ~1 s (redémarrage du service audio), effet immédiat et réversible (bouton Désactiver).&#10;• La courbe est celle de l'onglet Égaliseur, en temps réel ; les mesures de calibration bypassent automatiquement l'EQ système.&#10;&#10;Limites honnêtes : les flux WASAPI exclusif / ASIO contournent tout effet système (les DAW ont le pont ASIO intégré) ; les effets du fabricant (Realtek, Dolby…) sont suspendus sur une sortie activée — sauvegardés et restaurés à la désactivation ; une mise à jour de pilote peut effacer l'inscription — bouton « Réparer » (et réparation automatique au branchement à chaud)."/>
                            <Button Content="Réparer" FontSize="11" Command="{Binding SystemApoRepairCommand}"
                                    IsEnabled="{Binding !IsSystemApoBusy}"
                                    IsVisible="{Binding AnySystemApoEnabled}"
                                    ToolTip.Tip="Re-vérifie et réécrit l'inscription sur les sorties activées (une mise à jour de pilote audio peut l'effacer) — invite administrateur"/>
                            <Button Content="Tout retirer" FontSize="11" Command="{Binding SystemApoUninstallCommand}"
                                    IsEnabled="{Binding !IsSystemApoBusy}" IsVisible="{Binding AnySystemApoEnabled}"
                                    ToolTip.Tip="Restaure toutes les sorties à leur état d'origine, retire l'inscription et les fichiers partagés — invite administrateur"/>
                            <ProgressBar Width="120" Height="8" IsIndeterminate="True"
                                         IsVisible="{Binding IsSystemApoBusy}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{Binding SystemApoStatusText}" FontSize="10.5" Foreground="#8B93A7"
                                   TextWrapping="Wrap"/>

                        <ItemsControl ItemsSource="{Binding ApoEndpoints}" IsVisible="{Binding SystemApoSupported}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                        <TextBlock Text="{Binding Display}" FontSize="11" Width="250"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}"/>
                                        <TextBlock Text="{Binding State}" FontSize="10.5" Width="150"
                                                   VerticalAlignment="Center" Foreground="#8B93A7"/>
                                        <Button Content="Activer l'EQ sur cette sortie" FontSize="10.5"
                                                Command="{Binding $parent[UserControl].DataContext.SystemApoEnableCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding !Enabled}"
                                                IsEnabled="{Binding !Forbidden}"/>
                                        <Button Content="Désactiver" FontSize="10.5"
                                                Command="{Binding $parent[UserControl].DataContext.SystemApoDisableCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding Enabled}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ Barre de console — D25 : Windows = sources internes
                 (lecteur, générateur, DAW ASIO) ; macOS = routage par
                 périphérique virtuel (pas d'EQ système sur macOS) ═══ -->
            <Border Background="#1A1D26" CornerRadius="6" Padding="10,8"
                    BorderBrush="#2A2F3A" BorderThickness="1">
                <StackPanel Orientation="Vertical" Spacing="6">
                <!-- défilement horizontal — tous les réglages restent accessibles
                     même sur une fenêtre étroite -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding RoutingStatusText}" FontWeight="Bold"
                               VerticalAlignment="Center" Classes.active="{Binding IsRunning}"/>
                    <controls:HelpButton HelpTitle="{Binding RoutingHelpTitle}"
                                         HelpText="{Binding RoutingHelpText}"/>
                    <Button Classes="accent" Content="{Binding RoutingStartLabel}"
                            Command="{Binding ToggleRoutingCommand}"
                            IsVisible="{Binding !IsRunning}"/>
                    <Button Content="{Binding RoutingStopLabel}" Command="{Binding ToggleRoutingCommand}"
                            IsVisible="{Binding IsRunning}"/>
                    <CheckBox Content="Auto au lancement" IsChecked="{Binding AutoStart}"
                              VerticalAlignment="Center" FontSize="11"
                              ToolTip.Tip="Démarre automatiquement à l'ouverture de RoomEq"/>
                    <CheckBox Content="Preset auto par sortie" IsChecked="{Binding AutoOutputPreset}"
                              VerticalAlignment="Center" FontSize="11"
                              ToolTip.Tip="Adapte automatiquement l'égaliseur au périphérique master : preset de calibration s'il en existe un pour cette sortie, sinon correction usine si le casque/écouteur est reconnu dans la bibliothèque intégrée"/>

                    <Separator Width="1" Height="24" Background="#2A2F3A" Margin="4,0"/>

                    <Button Content="⟳" FontSize="11" MinWidth="30" Command="{Binding RefreshDevicesAsyncCommand}"
                            IsEnabled="{Binding !IsRefreshingDevices}"
                            ToolTip.Tip="Rafraîchir les périphériques (sans bloquer l'interface)"/>
                    <Button Content="Réglages son" FontSize="11" Command="{Binding OpenSoundPanelCommand}"/>
                </StackPanel>
                </ScrollViewer>

                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding VirtualStatusText}" VerticalAlignment="Center"
                               IsVisible="{Binding IsMacOS}"
                               FontSize="11" Foreground="#8B93A7" MaxWidth="440"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding AsioStatusText}" VerticalAlignment="Center"
                               FontSize="11" Foreground="#6FA8DC" MaxWidth="440" Margin="12,0,0,0"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="Pilote ASIO intégré : le DAW choisit « RoomEq ASIO », sa lecture alimente la piste « DAW (ASIO) » puis traverse l'égaliseur avant la vraie carte son — démarrez la console pour l'entendre."/>
                </WrapPanel>

                <!-- pilote hérité (D25) : une installation antérieure (v3.6/v3.7)
                     peut encore porter « RoomEq Input / RoomEq Output » —
                     nettoyage proposé, l'EQ système fonctionne sans pilote -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowLegacyDriverCleanup}">
                    <TextBlock Text="Ancien pilote de carte virtuelle détecté — RoomEq ne l'utilise plus (l'EQ système le remplace) :"
                               VerticalAlignment="Center" FontSize="11" Foreground="#8B93A7"/>
                    <Button Content="Supprimer le pilote" FontSize="11"
                            Command="{Binding UninstallDriverCommand}"
                            IsEnabled="{Binding !IsInstalling}"
                            ToolTip.Tip="Retire le pilote « RoomEq Input / RoomEq Output » d'une installation antérieure (invite administrateur). L'EQ système fonctionne sans pilote."/>
                    <TextBlock Text="{Binding InstallPhaseText}" FontSize="10.5"
                               Foreground="#FFC53D" VerticalAlignment="Center"
                               IsVisible="{Binding IsInstalling}"/>
                </StackPanel>

                <!-- guide macOS : le périphérique virtuel reste LA voie sur macOS -->
                <Expander Header="Guide — périphérique virtuel RoomEq (macOS)" FontSize="11"
                          IsVisible="{Binding IsMacOS}">
                    <StackPanel Spacing="4" Margin="4,6,0,2">
                        <ItemsControl ItemsSource="{Binding SelectedProvider.GuideLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Classes="muted" Text="{Binding}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ Console + éditeur d'EQ de piste ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,330">

            <!-- Tranches -->
            <DockPanel Grid.Column="0" LastChildFill="True">
                <Expander DockPanel.Dock="Bottom" Header="＋ Ajouter une piste (lecteur, générateur, pont DAW)"
                          FontSize="11" Margin="0,6,0,0">
                    <ScrollViewer MaxHeight="180">
                        <ItemsControl ItemsSource="{Binding AvailableSources}" Margin="2,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Margin="0,0,6,6" FontSize="11"
                                            Command="{Binding $parent[UserControl].DataContext.AddTrackCommand}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>

                <!-- défilement horizontal (tranches) ET vertical : une tranche est
                     plus haute que la fenêtre — on la fait défiler entièrement -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <ItemsControl ItemsSource="{Binding Channels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="strip" Width="142" Margin="0,0,6,0"
                                            Background="#20242E" CornerRadius="6" Padding="8,6"
                                            BorderBrush="#2A2F3A" BorderThickness="1"
                                            Classes.selected="{Binding IsSelected}">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11"
                                                       TextWrapping="Wrap" MaxHeight="30"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Badge}" FontSize="8.5" FontWeight="Bold"
                                                       Foreground="{Binding BadgeColor}"/>

                                            <controls:VuMeter Height="96"
                                                              LevelL="{Binding LevelL}"
                                                              LevelR="{Binding LevelR}"
                                                              PeakL="{Binding PeakL}"
                                                              PeakR="{Binding PeakR}"/>

                                            <!-- Panoramique -->
                                            <Slider Minimum="-1" Maximum="1" Value="{Binding Pan}"
                                                    TickFrequency="0.5" IsSnapToTickEnabled="False"
                                                    ToolTip.Tip="Panoramique"/>

                                            <!-- Fader -->
                                            <Slider Classes="fader" Minimum="0" Maximum="1.5"
                                                    Value="{Binding Fader}" Orientation="Vertical"
                                                    Height="150" HorizontalAlignment="Center"
                                                    ToolTip.Tip="Fader (1,0 = 0 dB)"/>
                                            <TextBlock Text="{Binding FaderText}" FontSize="10"
                                                       Foreground="#8B93A7" HorizontalAlignment="Center"/>

                                            <StackPanel Orientation="Horizontal" Spacing="4"
                                                        HorizontalAlignment="Center">
                                                <ToggleButton Classes="ms mute" Content="M" IsChecked="{Binding Mute}"
                                                              ToolTip.Tip="Mute"/>
                                                <ToggleButton Classes="ms solo" Content="S" IsChecked="{Binding Solo}"
                                                              ToolTip.Tip="Solo"/>
                                                <Button Classes="mini" Content="EQ"
                                                        Command="{Binding $parent[UserControl].DataContext.SelectTrackCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Égaliseur de la piste"/>
                                                <Button Classes="mini" Content="✕"
                                                        Command="{Binding $parent[UserControl].DataContext.RemoveTrackCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Retirer la piste"/>
                                            </StackPanel>

                                            <!-- Lecteur interne -->
                                            <StackPanel IsVisible="{Binding IsPlayer}" Spacing="3">
                                                <Button Classes="mini" Content="Ouvrir un fichier…"
                                                        Click="OnPickChannelFile"
                                                        IsEnabled="{Binding !HasFile}"/>
                                                <Button Classes="mini" Content="Éjecter" Click="OnEjectChannelFile"
                                                        IsEnabled="{Binding HasFile}"/>
                                            </StackPanel>

                                            <!-- Générateur interne -->
                                            <StackPanel IsVisible="{Binding IsGenerator}" Spacing="3">
                                                <ComboBox SelectedItem="{Binding SelectedSignalText}"
                                                          ItemsSource="{Binding SignalTexts}"
                                                          FontSize="10" MinHeight="24" Width="118"/>
                                                <ToggleButton Classes="ms" Content="ON" IsChecked="{Binding GeneratorOn}"
                                                              HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ═══ Tranche MASTER ═══ -->
                        <Border Width="170" Margin="8,0,0,0" Background="#181B23" CornerRadius="6"
                                Padding="10,8" BorderBrush="#FF9F1C" BorderThickness="1.2">
                            <StackPanel Spacing="6">
                                <TextBlock Text="MASTER" FontWeight="Bold" FontSize="13"
                                           Foreground="#FF9F1C" HorizontalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding Outputs}"
                                          SelectedItem="{Binding SelectedOutput}"
                                          FontSize="10" MinHeight="26">
                                    <ComboBox.ItemContainerTheme>
                                        <!-- anti-boucle (spec I-AUD-03 v2) : une sortie déjà
                                             routée en entrée est grisée, motif affiché -->
                                        <ControlTheme TargetType="ComboBoxItem"
                                                      BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                            <Setter Property="IsEnabled" Value="{Binding Selectable}" />
                                        </ControlTheme>
                                    </ComboBox.ItemContainerTheme>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding OutputInfoText}" FontSize="9"
                                           Foreground="#8B93A7" TextWrapping="Wrap" MaxHeight="26"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Preset de la sortie (adaptation au périphérique écouté) -->
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="Preset de la sortie" FontSize="9" FontWeight="Bold"
                                                   Foreground="#22D3EE" VerticalAlignment="Center"/>
                                        <controls:HelpButton HelpTitle="Preset de la sortie"
                                                             HelpText="RoomEq adapte l'égaliseur au périphérique de cette tranche MASTER :&#10;• preset de calibration mesuré sur cette sortie → réappliqué ;&#10;• casque/écouteurs reconnu dans la bibliothèque (ex. « Casque (JBL Tune Flex 2 Stereo) ») → correction usine appliquée automatiquement ;&#10;• sinon : rien ne change.&#10;&#10;Le sélecteur force un choix pour CETTE sortie, mémorisé d'une session à l'autre : Auto (politique ci-dessus), Aucun, un de vos presets, ou le modèle reconnu. L'onglet Égaliseur propose aussi « Lier ce preset à la sortie ».&#10;&#10;La case « Preset auto par sortie » de la barre de routage coupe toute application automatique."/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding OutputPresetOptions}"
                                              SelectedItem="{Binding SelectedOutputPresetOption}"
                                              FontSize="10" MinHeight="24">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" FontSize="10"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding OutputPresetText}" FontSize="8.5" Foreground="#8B93A7"
                                               TextWrapping="Wrap" MaxHeight="24" TextTrimming="CharacterEllipsis"
                                               TextAlignment="Center"/>
                                </StackPanel>

                                <!-- Volume WINDOWS de la sortie physique (Ctrl+Alt+↑/↓/M) -->
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Vol. carte physique" FontSize="9"
                                                   Foreground="#FF9F1C" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <controls:HelpButton HelpTitle="Volume carte physique"
                                                             HelpText="Règle le volume WINDOWS de la sortie sélectionnée ci-dessus (enceintes, casque…) — pas celui de la carte virtuelle, qui n'a AUCUN effet sur le niveau perçu.&#10;&#10;Il est SYNCHRONISÉ avec le curseur « Volume » de la barre du haut : déplacer l'un met l'autre à la même position, quel que soit l'ordre (et un réglage fait dans le mixeur Windows est suivi aussi).&#10;&#10;Raccourcis clavier (fonctionnent partout) :&#10;• Ctrl+Alt+↑ : +5 %&#10;• Ctrl+Alt+↓ : −5 %&#10;• Ctrl+Alt+M : sourdine&#10;&#10;Le fader MASTER ci-contre règle le niveau interne de RoomEq ; ce curseur règle le niveau système de la carte physique."/>
                                    </StackPanel>
                                    <Slider Minimum="0" Maximum="1" Value="{Binding RoutedVolume, Mode=TwoWay}"
                                            IsEnabled="{Binding HasRoutedVolume}"
                                            ToolTip.Tip="Volume système du périphérique de sortie physique"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <Button Classes="mini" Content="−" Command="{Binding RoutedVolumeDownCommand}"
                                                IsEnabled="{Binding HasRoutedVolume}" ToolTip.Tip="−5 % (Ctrl+Alt+↓)"/>
                                        <TextBlock Text="{Binding RoutedVolumeText}" FontSize="10"
                                                   Foreground="#8B93A7" MinWidth="40" TextAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Button Classes="mini" Content="+" Command="{Binding RoutedVolumeUpCommand}"
                                                IsEnabled="{Binding HasRoutedVolume}" ToolTip.Tip="+5 % (Ctrl+Alt+↑)"/>
                                        <Button Classes="mini" Content="M" Command="{Binding ToggleRoutedMuteCommand}"
                                                IsEnabled="{Binding HasRoutedVolume}" ToolTip.Tip="Sourdine (Ctrl+Alt+M)"/>
                                    </StackPanel>
                                </StackPanel>

                                <controls:VuMeter Height="130"
                                                  LevelL="{Binding MasterDispL}"
                                                  LevelR="{Binding MasterDispR}"
                                                  PeakL="{Binding MasterHoldL}"
                                                  PeakR="{Binding MasterHoldR}"/>

                                <Slider Minimum="0" Maximum="1.5" Value="{Binding MasterFader}"
                                        Orientation="Vertical" Height="150" Width="40"
                                        HorizontalAlignment="Center" ToolTip.Tip="Fader master"/>
                                <TextBlock Text="{Binding MasterFaderText}" FontSize="10"
                                           Foreground="#8B93A7" HorizontalAlignment="Center"/>
                                <ToggleButton Classes="ms mute" Content="M" IsChecked="{Binding MasterMute}"
                                              HorizontalAlignment="Center" ToolTip.Tip="Mute master"/>
                                <TextBlock Text="{Binding MasterEqSourceText}" FontSize="9"
                                           Foreground="#8B93A7" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Classes.active="{Binding ApoOnMaster}"
                                           ToolTip.Tip="D25 : quand l'EQ système (APO) est actif sur la sortie master, la courbe y est appliquée par le moteur audio Windows — le bus master contourne alors son propre EQ pour éviter la double correction."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Éditeur d'EQ de la piste sélectionnée -->
            <Border Grid.Column="1" Margin="8,0,0,0" Background="#181B23" CornerRadius="6"
                    BorderBrush="#2A2F3A" BorderThickness="1" Padding="10,8">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Égaliseur de piste" Classes="h2"/>
                        <TextBlock Text="{Binding TrackEq.Title}" FontSize="11" Foreground="#22D3EE"
                                   TextWrapping="Wrap"/>

                        <Border Background="#141720" CornerRadius="4" Height="150"
                                ClipToBounds="True">
                            <controls:PlotControl x:Name="TrackEqPlot" XMin="20" XMax="20000"
                                                  YMin="-15" YMax="15" TickStepY="3"/>
                        </Border>
                        <TextBlock Text="{Binding TrackEq.CurveInfo}" FontSize="10" Foreground="#8B93A7"/>

                        <WrapPanel>
                            <Button Classes="mini" Content="+ Bande" Margin="0,0,4,4"
                                    Command="{Binding TrackEq.AddBandCommand}"/>
                            <Button Classes="mini" Content="Aplatir" Margin="0,0,4,4"
                                    Command="{Binding TrackEq.FlattenCommand}"/>
                            <Button Classes="mini" Content="Aucun EQ" Margin="0,0,4,4"
                                    Command="{Binding TrackEq.ClearAllCommand}"/>
                            <Button Classes="mini" Content="Coupe-bas 80 Hz" Margin="0,0,4,4"
                                    Command="{Binding TrackEq.QuickPresetCommand}" CommandParameter="hp80"/>
                            <Button Classes="mini" Content="Présence 3 kHz" Margin="0,0,4,4"
                                    Command="{Binding TrackEq.QuickPresetCommand}" CommandParameter="presence"/>
                            <Button Classes="mini" Content="Aigus adoucis" Margin="0,0,4,4"
                                    Command="{Binding TrackEq.QuickPresetCommand}" CommandParameter="soft"/>
                        </WrapPanel>

                        <ItemsControl ItemsSource="{Binding TrackEq.Bands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#20242E" CornerRadius="4" Padding="6,4" Margin="0,2">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FreqText}" Width="66"
                                                           VerticalAlignment="Center" Foreground="#22D3EE"
                                                           FontWeight="Bold" FontSize="11"/>
                                                <ComboBox ItemsSource="{Binding Types}"
                                                          SelectedItem="{Binding Type}" Width="100"
                                                          FontSize="11" MinHeight="26"/>
                                                <Button Content="X" FontSize="10" Padding="6,2" MinHeight="24"
                                                        Command="{Binding $parent[UserControl].DataContext.TrackEq.RemoveBandCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Fréq" Width="32" FontSize="10"
                                                           Foreground="#8B93A7" VerticalAlignment="Center"/>
                                                <NumericUpDown Value="{Binding Frequency}" Minimum="20" Maximum="20000"
                                                               Increment="10" Width="96" FormatString="0" MinHeight="26"/>
                                                <TextBlock Text="Gain" Width="30" FontSize="10"
                                                           Foreground="#8B93A7" VerticalAlignment="Center"/>
                                                <NumericUpDown Value="{Binding GainDb}" Minimum="-24" Maximum="24"
                                                               Increment="0.5" Width="80" FormatString="0.0" MinHeight="26"/>
                                                <TextBlock Text="Q" Width="12" FontSize="10"
                                                           Foreground="#8B93A7" VerticalAlignment="Center"/>
                                                <NumericUpDown Value="{Binding Q}" Minimum="0.1" Maximum="20"
                                                               Increment="0.1" Width="74" FormatString="0.00" MinHeight="26"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="muted"
                                   Text="Chaque piste possède son propre égaliseur, indépendant de l'onglet Égaliseur (qui reste appliqué au bus master). Les réglages sont conservés d'une session à l'autre."/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Égaliseur de piste — boutons rapides" Classes="muted" VerticalAlignment="Center"/>
                            <controls:HelpButton HelpTitle="Égaliseur de piste"
                                                 HelpText="Égaliseur dédié à la piste sélectionnée (LED « EQ » allumée = actif).&#10;&#10;• + Bande : ajoute un filtre peaking éditable (fréquence, gain, Q).&#10;• Aplatir : toutes les bandes à 0 dB (elles restent).&#10;• Aucun EQ : supprime toutes les bandes.&#10;• Coupe-bas 80 Hz : filtre passe-haut pour enceintes avec caisson ou voix.&#10;• Présence 3 kHz / Aigus adoucis : corrections d'écoute rapides.&#10;• X : supprime la bande concernée."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ Statut local ═══ -->
        <Border Grid.Row="2" Background="#1A1D26" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="#8B93A7" FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
