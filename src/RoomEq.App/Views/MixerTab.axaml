<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RoomEq.App.Controls"
             x:Class="RoomEq.App.Views.MixerTab">

    <UserControl.Styles>
        <!-- état actif coloré -->
        <Style Selector="TextBlock.active">
            <Setter Property="Foreground" Value="#4ADE80"/>
        </Style>
        <!-- verdict d'échec (D26 : lisible là où l'utilisateur a cliqué) -->
        <Style Selector="TextBlock.verdictError">
            <Setter Property="Foreground" Value="#F0533F"/>
        </Style>
        <Style Selector="TextBlock.verdictOk">
            <Setter Property="Foreground" Value="#4ADE80"/>
        </Style>
        <!-- espacement des éléments des barres d'outils (WrapPanel sans Spacing) -->
        <Style Selector="WrapPanel > TextBlock">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="WrapPanel > Button">
            <Setter Property="Margin" Value="0,0,8,4"/>
        </Style>
        <Style Selector="WrapPanel > CheckBox">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="WrapPanel > ComboBox">
            <Setter Property="Margin" Value="0,0,8,4"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">

        <!-- D26 (v3.9.0) : la console a été retirée — l'EQ système (APO) est
             le SEUL chemin du son Windows. Cet onglet est son poste de
             pilotage : sorties activées, verdict des actions, volume de la
             carte d'écoute, preset adapté, nettoyage du pilote hérité. -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" Margin="0,0,4,0" MaxWidth="980" HorizontalAlignment="Stretch">

                <!-- ═══ EQ système (APO) — LE chemin du son Windows, sans
                     pilote ni mode test ni tierce partie ; une activation =
                     une invite administrateur ═══ -->
                <Border Background="#1B1F27" CornerRadius="6"
                        BorderBrush="#2A2F3A" BorderThickness="1" Padding="10,8">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="EQ système (sans pilote)" FontWeight="Bold" FontSize="13"
                                       VerticalAlignment="Center"
                                       Classes.active="{Binding AnySystemApoEnabled}"/>
                            <controls:HelpButton HelpTitle="EQ système — comment ça marche"
                                                 HelpText="L'égaliseur de RoomEq s'installe DANS le moteur audio de Windows (technologie officielle « Audio Processing Object », la même que les effets Realtek/Dolby) : tout ce qui sort par une sortie activée traverse l'égaliseur — musique, navigateur, jeux, notifications.&#10;&#10;• Aucun pilote, aucun mode test, aucun logiciel tiers ; latence ajoutée NULLE (aucune désynchro son/image).&#10;• Activation = une invite administrateur, le son s'interrompt ~1 s (redémarrage du service audio), effet immédiat et réversible (bouton Désactiver).&#10;• La courbe est celle de l'onglet Égaliseur, en temps réel ; les mesures de calibration bypassent automatiquement l'EQ système.&#10;&#10;Si l'activation échoue, la raison s'affiche en rouge sous ce panneau (invite refusée, périphérique retiré…) : elle reste visible jusqu'à l'action suivante.&#10;&#10;Limites honnêtes : les flux WASAPI exclusif / ASIO contournent tout effet système (les DAW ont les greffons RoomEq VST/AU) ; les effets du fabricant (Realtek, Dolby…) sont suspendus sur une sortie activée — sauvegardés et restaurés à la désactivation ; une mise à jour de pilote peut effacer l'inscription — bouton « Réparer »."/>
                            <Button Content="Réparer" FontSize="11" Command="{Binding SystemApoRepairCommand}"
                                    IsEnabled="{Binding !IsSystemApoBusy}"
                                    IsVisible="{Binding AnySystemApoEnabled}"
                                    ToolTip.Tip="Re-vérifie et réécrit l'inscription sur les sorties activées (une mise à jour de pilote audio peut l'effacer) — invite administrateur"/>
                            <Button Content="Tout retirer" FontSize="11" Command="{Binding SystemApoUninstallCommand}"
                                    IsEnabled="{Binding !IsSystemApoBusy}" IsVisible="{Binding AnySystemApoEnabled}"
                                    ToolTip.Tip="Restaure toutes les sorties à leur état d'origine, retire l'inscription et les fichiers partagés — invite administrateur"/>
                            <ProgressBar Width="120" Height="8" IsIndeterminate="True"
                                         IsVisible="{Binding IsSystemApoBusy}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{Binding SystemApoStatusText}" FontSize="10.5" Foreground="#8B93A7"
                                   TextWrapping="Wrap"/>

                        <!-- D26 : verdict de la dernière action, succès comme échec -->
                        <TextBlock Text="{Binding SystemApoVerdictText}" FontSize="11"
                                   TextWrapping="Wrap" IsVisible="{Binding HasSystemApoVerdict}"
                                   Classes.verdictError="{Binding SystemApoVerdictIsError}"
                                   Classes.verdictOk="{Binding !SystemApoVerdictIsError}"/>

                        <ItemsControl ItemsSource="{Binding ApoEndpoints}" IsVisible="{Binding SystemApoSupported}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                        <TextBlock Text="{Binding Display}" FontSize="11" Width="250"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}"/>
                                        <TextBlock Text="{Binding State}" FontSize="10.5" Width="150"
                                                   VerticalAlignment="Center" Foreground="#8B93A7"/>
                                        <Button Content="Activer l'EQ sur cette sortie" FontSize="10.5"
                                                Command="{Binding $parent[UserControl].DataContext.SystemApoEnableCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding !Enabled}"
                                                IsEnabled="{Binding !Forbidden}"/>
                                        <Button Content="Désactiver" FontSize="10.5"
                                                Command="{Binding $parent[UserControl].DataContext.SystemApoDisableCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding Enabled}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ Écoute : volume de la carte physique + preset adapté ═══ -->
                <Border Background="#1A1D26" CornerRadius="6" Padding="10,8"
                        BorderBrush="#2A2F3A" BorderThickness="1">
                    <StackPanel Spacing="8">

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Écoute" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <controls:HelpButton HelpTitle="Écoute"
                                                 HelpText="La sortie d'écoute est celle de la barre du haut : tout ce qui la règle suit ici.&#10;&#10;• VOLUME CARTE PHYSIQUE : le volume WINDOWS de la sortie (enceintes, casque…) — synchronisé avec le curseur « Volume » de la barre du haut et les raccourcis Ctrl+Alt+↑ / ↓ / M ; un réglage fait dans le mixeur Windows est suivi aussi.&#10;• PRESET DE LA SORTIE : RoomEq adapte l'égaliseur (donc la courbe envoyée à l'EQ système) au périphérique d'écoute — preset de calibration mesuré, ou correction usine si le casque/écouteur est reconnu dans la bibliothèque intégrée."/>
                            <Button Content="⟳" FontSize="11" MinWidth="30" Command="{Binding RefreshDevicesAsyncCommand}"
                                    IsEnabled="{Binding !IsRefreshingDevices}"
                                    ToolTip.Tip="Rafraîchir les sorties et l'état de l'EQ système (sans bloquer l'interface)"/>
                            <Button Content="Réglages son" FontSize="11" Command="{Binding OpenSoundPanelCommand}"
                                    ToolTip.Tip="Ouvre le panneau son de Windows"/>
                        </StackPanel>

                        <!-- Volume de la carte physique d'écoute (raccourcis Ctrl+Alt+↑/↓/M) -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Volume carte physique :" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#FF9F1C" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RoutedVolumeTarget}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#8B93A7" MaxWidth="300" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="Périphérique dont le volume Windows est réglé ici"/>
                            <Button Content="−" FontSize="11" MinWidth="28" Command="{Binding RoutedVolumeDownCommand}"
                                    IsEnabled="{Binding HasRoutedVolume}" ToolTip.Tip="−5 % (Ctrl+Alt+↓)"/>
                            <TextBlock Text="{Binding RoutedVolumeText}" FontSize="11" MinWidth="44"
                                       TextAlignment="Center" VerticalAlignment="Center" Foreground="#8B93A7"/>
                            <Button Content="+" FontSize="11" MinWidth="28" Command="{Binding RoutedVolumeUpCommand}"
                                    IsEnabled="{Binding HasRoutedVolume}" ToolTip.Tip="+5 % (Ctrl+Alt+↑)"/>
                            <Button Content="M" FontSize="11" MinWidth="28" Command="{Binding ToggleRoutedMuteCommand}"
                                    IsEnabled="{Binding HasRoutedVolume}" ToolTip.Tip="Sourdine (Ctrl+Alt+M)"/>
                            <TextBlock Text="(identique au curseur Volume de la barre du haut)" FontSize="10"
                                       Foreground="#5A6274" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Preset adapté au périphérique d'écoute -->
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox Content="Preset auto par sortie" IsChecked="{Binding AutoOutputPreset}"
                                      VerticalAlignment="Center" FontSize="11"
                                      ToolTip.Tip="Adapte automatiquement l'égaliseur au périphérique d'écoute : preset de calibration s'il en existe un pour cette sortie, sinon correction usine si le casque/écouteur est reconnu dans la bibliothèque intégrée"/>
                            <TextBlock Text="Preset de la sortie" FontSize="11" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding OutputPresetOptions}"
                                      SelectedItem="{Binding SelectedOutputPresetOption}"
                                      FontSize="11" MinWidth="220" MinHeight="26">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="10"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock Text="{Binding OutputPresetText}" FontSize="10.5" Foreground="#8B93A7"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- pilote hérité (D25) : une installation antérieure (v3.6/v3.7)
                     peut encore porter « RoomEq Input / RoomEq Output » —
                     nettoyage proposé, l'EQ système fonctionne sans pilote -->
                <Border Background="#1A1D26" CornerRadius="6" Padding="10,6"
                        BorderBrush="#2A2F3A" BorderThickness="1"
                        IsVisible="{Binding ShowLegacyDriverCleanup}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Ancien pilote de carte virtuelle détecté — RoomEq ne l'utilise plus (l'EQ système le remplace) :"
                                   VerticalAlignment="Center" FontSize="11" Foreground="#8B93A7" TextWrapping="Wrap"/>
                        <Button Content="Supprimer le pilote" FontSize="11"
                                Command="{Binding UninstallDriverCommand}"
                                IsEnabled="{Binding !IsInstalling}"
                                ToolTip.Tip="Retire le pilote « RoomEq Input / RoomEq Output » d'une installation antérieure (invite administrateur). L'EQ système fonctionne sans pilote."/>
                        <TextBlock Text="{Binding InstallPhaseText}" FontSize="10.5"
                                   Foreground="#FFC53D" VerticalAlignment="Center"
                                   IsVisible="{Binding IsInstalling}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Statut local ═══ -->
        <Border Grid.Row="1" Background="#1A1D26" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="#8B93A7" FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
