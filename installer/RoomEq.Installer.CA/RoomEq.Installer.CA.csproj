<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RoomEq.Installer.CA</AssemblyName>
    <!-- le CA tourne en MSI (SYSTEM) : fenêtre et console cachées -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="6.0.2" />
    <!-- assemblys de référence .NET Framework : permet de compiler le CA sous Linux/CI -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- X509Store (import du certificat de test) vit dans System.Security.dll -->
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
