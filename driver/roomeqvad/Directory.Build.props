<!--
  WDK/SDK via NuGet (voie officielle Microsoft, cf. Windows-driver-samples).
  Restaurer avec : nuget restore packages.config -PackagesDirectory packages
  (build_driver.ps1 et la CI le font automatiquement).
  NB : ce Directory.Build.props est LOCAL au dossier du pilote ; les projets
  C# du dépôt ne le voient pas (MSBuild n'importe que le plus proche).
-->
<Project>
  <PropertyGroup>
    <WdkNuGetVersion>10.0.26100.6584</WdkNuGetVersion>
  </PropertyGroup>
  <ImportGroup Label="WdkNuGet">
    <Import Project="$(MSBuildThisFileDirectory)packages\Microsoft.Windows.WDK.x64.$(WdkNuGetVersion)\build\native\Microsoft.Windows.WDK.x64.props" Condition="Exists('$(MSBuildThisFileDirectory)packages\Microsoft.Windows.WDK.x64.$(WdkNuGetVersion)\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'"/>
    <Import Project="$(MSBuildThisFileDirectory)packages\Microsoft.Windows.SDK.CPP.x64.$(WdkNuGetVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props" Condition="Exists('$(MSBuildThisFileDirectory)packages\Microsoft.Windows.SDK.CPP.x64.$(WdkNuGetVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'"/>
    <Import Project="$(MSBuildThisFileDirectory)packages\Microsoft.Windows.SDK.CPP.$(WdkNuGetVersion)\build\native\Microsoft.Windows.SDK.cpp.props" Condition="Exists('$(MSBuildThisFileDirectory)packages\Microsoft.Windows.SDK.CPP.$(WdkNuGetVersion)\build\native\Microsoft.Windows.SDK.cpp.props')"/>
  </ImportGroup>
</Project>
